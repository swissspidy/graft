{
  "name": "graft-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "graft": "tsx packages/cli/src/main.ts",
    "typecheck": "tsc -p packages/core && tsc -p packages/cli && tsc -p packages/renderer-react && tsc -p hosts/wordpress/adapter && tsc -p hosts/wordpress/e2e",
    "test": "vitest run",
    "validate:examples": "tsx packages/cli/src/main.ts validate --surface hosts/wordpress/plugin/surfaces/7.1.json examples/specs",
    "surface:generate": "tsx hosts/wordpress/adapter/src/cli.ts",
    "test:wp": "pnpm build && tsx hosts/wordpress/adapter/src/smoke.ts",
    "build": "tsx hosts/wordpress/adapter/scripts/build-client.ts",
    "test:e2e": "playwright test -c hosts/wordpress/e2e/playwright.config.ts",
    "verify:examples": "tsx packages/cli/src/main.ts verify --surface hosts/wordpress/plugin/surfaces/7.1.json --spec examples/specs examples/builds/review-queue.json examples/builds/quick-approve.json",
    "test:compile": "tsx hosts/wordpress/adapter/src/compile-smoke.ts",
    "test:canary": "tsx hosts/wordpress/adapter/src/canary-test.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "@playwright/test": "1.56.1"
  }
}
