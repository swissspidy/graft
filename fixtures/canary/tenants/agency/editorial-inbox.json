{
	"graft": 1,
	"spec": {
		"id": "editorial-inbox",
		"hash": "sha256:56d10cd2f60277341e551014306a65e82bb320456ce77456704cdbded3bd7e90"
	},
	"surface": {
		"host": "wordpress",
		"hostVersion": "7.1.2",
		"hash": "sha256:19604b84149c0450e91760edf227d37052c0e8d93934e34b98cf89b45e58ac06"
	},
	"mount": {
		"slot": "admin.page",
		"menu": {
			"parent": "posts",
			"title": "Editorial inbox"
		}
	},
	"data": {
		"queue": {
			"call": "posts.list",
			"input": {
				"status": [
					"pending"
				],
				"orderby": "date",
				"order": "asc"
			}
		}
	},
	"tree": {
		"type": "stack",
		"props": {
			"gap": 4
		},
		"children": [
			{
				"type": "heading",
				"props": {
					"level": 1
				},
				"children": "Editorial inbox"
			},
			{
				"type": "text",
				"props": {
					"variant": "muted"
				},
				"children": "Posts waiting for review, oldest first."
			},
			{
				"type": "table",
				"props": {
					"rows": {
						"$data": "queue.items"
					},
					"fields": [
						{
							"id": "title",
							"label": "Title",
							"primary": true
						},
						{
							"id": "author.name",
							"label": "Author",
							"type": "user"
						},
						{
							"id": "date",
							"label": "Submitted",
							"type": "datetime"
						}
					],
					"actions": [
						{
							"id": "approve",
							"label": "Approve",
							"primary": true,
							"visible": {
								"$can": "posts.status:write"
							},
							"onClick": {
								"$call": "posts.update_status",
								"input": {
									"id": {
										"$field": "id"
									},
									"status": "publish"
								},
								"then": [
									"remove-row:queue"
								],
								"notice": "Post published."
							}
						}
					],
					"empty": "Inbox zero"
				}
			}
		]
	},
	"checks": [
		{
			"criterion": "pending-only",
			"fixtures": {
				"users": [
					{
						"as": "e",
						"role": "editor"
					}
				],
				"posts": [
					{
						"title": "Draft A",
						"status": "pending"
					},
					{
						"title": "Draft B",
						"status": "draft"
					},
					{
						"title": "Post C",
						"status": "publish"
					}
				]
			},
			"view_as": "e",
			"expect": [
				{
					"rows": [
						"Draft A"
					]
				}
			]
		},
		{
			"criterion": "columns",
			"fixtures": {
				"users": [
					{
						"as": "e",
						"role": "editor"
					}
				],
				"posts": [
					{
						"title": "Draft A",
						"status": "pending"
					}
				]
			},
			"view_as": "e",
			"expect": [
				{
					"columns": [
						"Title",
						"Author",
						"Submitted"
					]
				}
			]
		},
		{
			"criterion": "approve",
			"fixtures": {
				"users": [
					{
						"as": "e",
						"role": "editor"
					}
				],
				"posts": [
					{
						"title": "Draft A",
						"status": "pending"
					}
				]
			},
			"view_as": "e",
			"steps": [
				{
					"action": "approve",
					"row": {
						"title": "Draft A"
					}
				}
			],
			"expect": [
				{
					"rows": []
				},
				{
					"post": {
						"title": "Draft A",
						"status": "publish"
					}
				}
			]
		},
		{
			"criterion": "contributors-no-approve",
			"fixtures": {
				"users": [
					{
						"as": "c",
						"role": "contributor"
					}
				],
				"posts": [
					{
						"title": "Draft A",
						"status": "pending",
						"author": "c"
					}
				]
			},
			"view_as": "c",
			"expect": [
				{
					"rows": [
						"Draft A"
					]
				},
				{
					"action": "approve",
					"row": {
						"title": "Draft A"
					},
					"available": false
				}
			]
		},
		{
			"criterion": "empty-state",
			"fixtures": {
				"users": [
					{
						"as": "e",
						"role": "editor"
					}
				],
				"posts": []
			},
			"view_as": "e",
			"expect": [
				{
					"rows": []
				},
				{
					"text": "Inbox zero"
				}
			]
		}
	],
	"refs": {
		"slot": "admin.page",
		"components": {
			"heading": [
				"level"
			],
			"stack": [
				"gap"
			],
			"table": [
				"actions",
				"empty",
				"fields",
				"rows"
			],
			"text": [
				"variant"
			]
		},
		"capabilities": [
			"posts.list",
			"posts.update_status"
		],
		"scopes": [
			"posts.status:write",
			"posts:read"
		]
	},
	"provenance": {
		"compiler": "handwritten",
		"strategy": "handwritten"
	}
}
