	},
	"data": {},
	"tree": {
		"type": "row-action",
		"props": {
			"id": "approve",
			"label": "Approve",
			"visible": {
				"$and": [
					{
						"$eq": [
							{
								"$slot": "post.status"
							},
							"pending"
						]
					},
					{
						"$can": "posts.status:write",
						"on": {
							"$slot": "post"
						}
					}
				]
			},
			"onClick": {
				"$call": "posts.update_status",
				"input": {
					"id": {
						"$slot": "post.id"
					},
					"status": "publish"
				},
				"then": [
					"reload:page"
				],
				"notice": "Post published."
			}
		}
	},
	"checks": [
		{
			"criterion": "shown-on-pending",
			"fixtures": {
