		},
		"computed": {
			"authors": {
				"call": "distinct",
				"args": {
					"items": {
						"path": "/pending/items"
					},
					"by": "author/id"
				}
			},
			"shown": {
				"call": "if",
				"args": {
					"condition": {
						"call": "notEquals",
						"args": {
							"a": {
								"path": "/form/author"
							},
							"b": ""
						}
					},
					"then": {
						"call": "filter",
						"args": {
							"items": {
								"path": "/pending/items"
							},
							"by": "author/id",
							"equals": {
								"path": "/form/author"
							}
						}
					},
					"else": {
						"path": "/pending/items"
					}
				}
			}
		},
