				"id": "author-btn",
				"component": "Button",
				"child": "author-btn-label",
				"variant": "default",
				"actionId": {
					"call": "formatString",
					"args": {
						"value": "author-${lower(value: ${author/name})}"
					}
				},
				"action": {
					"functionCall": {
						"call": "set",
						"args": {
							"target": "/form/author",
							"value": {
								"path": "author/id"
							}
						}
					}
				}
			},
			{
				"id": "author-btn-label",
				"component": "Text",
				"text": {
					"path": "author/name"
				}
			},
			{
				"id": "pending-table",
				"component": "Table",
				"rows": {
					"path": "/shown"
				},
				"fields": [
					{
						"id": "title",
						"label": "Title",
						"type": "string",
						"primary": true
					},
					{
						"id": "author/name",
						"label": "Author",
						"type": "string"
					},
					{
						"id": "date",
						"label": "Date",
						"type": "datetime"
					}
				],
				"rowActions": [
					{
						"id": "approve",
						"label": "Approve",
						"variant": "primary",
						"visible": {
							"call": "can",
							"args": {
								"scope": "posts.status:write"
							}
						},
						"action": {
							"event": {
								"name": "approve",
								"context": {
									"id": {
										"path": "id"
									}
								}
							}
						}
					}
				],
				"empty": "No pending posts."
			}
		]
