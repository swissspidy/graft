				"excerpt": {
					"$context": "excerpt"
				}
			},
			"then": [
				"reload:page"
			],
			"notice": "Headline and excerpt saved."
		},
		"publish": {
			"call": "posts.update_status",
			"input": {
				"id": {
					"$context": "id"
				},
				"status": "publish"
			},
			"then": [
				"reload:page"
			],
			"notice": "Post published."
		}
	}
}
