{
	"graft": 1,
	"spec": {
		"id": "status-board",
		"hash": "sha256:be0c7a3ea99ebdb2922afe82fd56276c46a031d4031222f5f4fb5b90feac6830"
	},
	"surface": {
		"host": "emdash",
		"hostVersion": "1.0.1",
		"hash": "sha256:b9329970caab68a82f9e7fe44db516aa9d4dfddfe028473af619f480e85a35a0"
	},
	"mount": {
		"slot": "admin.page",
		"title": "Status board"
	},
	"data": {
		"posts": {
			"call": "content.list",
			"input": {
				"collection": "posts",
				"order": "desc",
				"limit": 100
			}
		}
	},
	"ui": {
		"protocol": "a2ui/v0.9",
		"catalogId": "graft:emdash",
		"initial": {
			"form": {
				"status": "published"
			}
		},
		"computed": {
			"drafts": {
				"call": "filter",
				"args": {
					"items": {
						"path": "/posts/items"
					},
					"by": "status",
					"equals": "draft"
				}
			},
			"published": {
				"call": "filter",
				"args": {
					"items": {
						"path": "/posts/items"
					},
					"by": "status",
					"equals": "published"
				}
			},
			"draftCount": {
				"call": "count",
				"args": {
					"value": {
						"path": "/drafts"
					}
				}
			},
			"publishedCount": {
				"call": "count",
				"args": {
					"value": {
						"path": "/published"
					}
				}
			},
			"shown": {
				"call": "filter",
				"args": {
					"items": {
						"path": "/posts/items"
					},
					"by": "status",
					"equals": {
						"call": "if",
						"args": {
							"condition": {
								"call": "equals",
								"args": {
									"a": {
										"path": "/form/status"
									},
									"b": "published"
								}
							},
							"then": "published",
							"else": "draft"
						}
					}
				}
			}
		},
		"components": [
			{
				"id": "root",
				"component": "Column",
				"children": [
					"summary",
					"tabs",
					"list"
				]
			},
			{
				"id": "summary",
				"component": "Text",
				"variant": "caption",
				"text": {
					"call": "formatString",
					"args": {
						"value": "Drafts: ${/draftCount} · Published: ${/publishedCount}"
					}
				}
			},
			{
				"id": "tabs",
				"component": "Row",
				"children": [
					"drafts",
					"published"
				]
			},
			{
				"id": "drafts",
				"component": "Button",
				"child": "drafts-label",
				"variant": {
					"call": "if",
					"args": {
						"condition": {
							"call": "equals",
							"args": {
								"a": {
									"path": "/form/status"
								},
								"b": "draft"
							}
						},
						"then": "primary",
						"else": "default"
					}
				},
				"action": {
					"functionCall": {
						"call": "set",
						"args": {
							"target": "/form/status",
							"value": "draft"
						}
					}
				}
			},
			{
				"id": "drafts-label",
				"component": "Text",
				"text": {
					"call": "formatString",
					"args": {
						"value": "Drafts (${/draftCount})"
					}
				}
			},
			{
				"id": "published",
				"component": "Button",
				"child": "published-label",
				"variant": {
					"call": "if",
					"args": {
						"condition": {
							"call": "equals",
							"args": {
								"a": {
									"path": "/form/status"
								},
								"b": "published"
							}
						},
						"then": "primary",
						"else": "default"
					}
				},
				"action": {
					"functionCall": {
						"call": "set",
						"args": {
							"target": "/form/status",
							"value": "published"
						}
					}
				}
			},
			{
				"id": "published-label",
				"component": "Text",
				"text": {
					"call": "formatString",
					"args": {
						"value": "Published (${/publishedCount})"
					}
				}
			},
			{
				"id": "list",
				"component": "Table",
				"rows": {
					"path": "/shown"
				},
				"fields": [
					{
						"id": "title",
						"label": "Title",
						"primary": true
					},
					{
						"id": "updatedAt",
						"label": "Last updated",
						"type": "relative_time"
					}
				],
				"rowActions": [
					{
						"id": "publish",
						"label": "Publish",
						"variant": "primary",
						"visible": {
							"call": "and",
							"args": {
								"values": [
									{
										"call": "equals",
										"args": {
											"a": {
												"path": "/form/status"
											},
											"b": "draft"
										}
									},
									{
										"call": "can",
										"args": {
											"scope": "content.status:write"
										}
									}
								]
							}
						},
						"action": {
							"event": {
								"name": "publish",
								"context": {
									"id": {
										"path": "id"
									}
								}
							}
						}
					},
					{
						"id": "unpublish",
						"label": "Unpublish",
						"variant": "default",
						"visible": {
							"call": "and",
							"args": {
								"values": [
									{
										"call": "equals",
										"args": {
											"a": {
												"path": "/form/status"
											},
											"b": "published"
										}
									},
									{
										"call": "can",
										"args": {
											"scope": "content.status:write"
										}
									}
								]
							}
						},
						"action": {
							"event": {
								"name": "unpublish",
								"context": {
									"id": {
										"path": "id"
									}
								}
							}
						}
					}
				],
				"empty": {
					"call": "if",
					"args": {
						"condition": {
							"call": "equals",
							"args": {
								"a": {
									"path": "/form/status"
								},
								"b": "published"
							}
						},
						"then": "Nothing published",
						"else": "No drafts"
					}
				}
			}
		]
	},
	"events": {
		"publish": {
			"call": "content.publish",
			"input": {
				"collection": "posts",
				"id": {
					"$context": "id"
				}
			},
			"then": [
				"refresh:posts"
			],
			"notice": "Published."
		},
		"unpublish": {
			"call": "content.unpublish",
			"input": {
				"collection": "posts",
				"id": {
					"$context": "id"
				}
			},
			"then": [
				"refresh:posts"
			],
			"notice": "Taken offline."
		}
	},
