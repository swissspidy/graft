// Generated by scripts/write-manifest.ts from src/plugin/manifest.ts. Do not edit.
{
	"$schema": "https://emdashcms.com/schemas/emdash-plugin.schema.json",
	"slug": "graft",
	"version": "0.1.0",
	// Replace with your atproto DID before publishing to the registry.
	"publisher": "did:plc:replace-with-your-publisher-did",
	"license": "Apache-2.0",
	"author": {
		"name": "Graft contributors",
		"url": "https://github.com/swissspidy/graft"
	},
	"security": {
		"url": "https://github.com/swissspidy/graft/security/advisories/new"
	},
	"name": "Graft",
	"description": "Durable, spec-driven customizations: verified builds served as Block Kit, upgraded when EmDash changes.",
	"capabilities": [
		"content:read",
		"content:publish",
		"users:read",
		"network:request"
	],
	"allowedHosts": [
		"api.anthropic.com"
	],
	"storage": {},
	"admin": {
		"pages": [
			{
				"path": "/customizations",
				"label": "Customizations",
				"icon": "puzzle-piece"
			}
		],
		"widgets": [
			{
				"id": "customizations",
				"title": "Customizations",
				"size": "full"
			}
		],
		"editorPanels": [
			{
				"id": "customizations",
				"title": "Customizations",
				"route": "panel",
				"order": 50
			}
		],
		"settingsSchema": {
			"anthropicApiKey": {
				"type": "secret",
				"label": "Anthropic API key",
				"description": "Used to compile customizations written in the admin. Stored encrypted."
			},
			"model": {
				"type": "select",
				"label": "Model",
				"options": [
					{
						"label": "Claude Opus 5.5",
						"value": "claude-opus-5-5"
					},
					{
						"label": "Claude Sonnet 5.5",
						"value": "claude-sonnet-5-5"
					}
				],
				"default": "claude-opus-5-5"
			},
			"effort": {
				"type": "select",
				"label": "Effort",
				"description": "Lower is faster. Each compile step must finish within the host request time limit.",
				"options": [
					{
						"label": "Low",
						"value": "low"
					},
					{
						"label": "Medium",
						"value": "medium"
					},
					{
						"label": "High",
						"value": "high"
					}
				],
				"default": "medium"
			},
			"modelEndpoint": {
				"type": "url",
				"label": "Model endpoint",
				"description": "Base URL of the Claude API (default https://api.anthropic.com). Its host must be an allowed host of the plugin."
			}
		}
	}
}
