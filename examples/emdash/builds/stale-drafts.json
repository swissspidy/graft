	"mount": {
		"slot": "dashboard.widget",
		"title": "Stale drafts"
	},
	"data": {
		"drafts": {
			"call": "content.list",
			"input": {
				"collection": "posts",
				"status": "draft",
				"limit": 10
			}
		}
	},
	"tree": {
		"type": "stack",
		"children": [
			{
				"type": "table",
				"props": {
					"rows": {
						"$data": "drafts.items"
					},
					"columns": [
						{
							"key": "title",
							"label": "Title",
							"primary": true
						},
						{
							"key": "age",
							"label": "Days since update",
							"format": "number",
							"value": {
								"$daysSince": {
									"$field": "updatedAt"
								}
							},
							"tone": {
								"$if": [
									{
										"$gte": [
											{
												"$daysSince": {
													"$field": "updatedAt"
												}
											},
											30
										]
									},
									"error",
									{
										"$if": [
											{
												"$gte": [
													{
														"$daysSince": {
															"$field": "updatedAt"
														}
													},
													7
												]
											},
											"warning",
											"success"
										]
									}
								]
							}
						}
					],
					"empty": "No drafts"
				}
			}
		]
	},
