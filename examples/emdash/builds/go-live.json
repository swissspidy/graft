									},
									"id": {
										"$slot": "entry.id"
									}
								},
								"then": [
									"reload:page"
								],
								"notice": "The post is live."
							}
						}
					},
					{
						"type": "button",
						"props": {
							"id": "take-offline",
							"label": "Take offline",
							"style": "danger",
