								"$and": [
									{
										"$eq": [
											{
												"$slot": "entry.status"
											},
											"published"
										]
									},
									{
										"$can": "content.status:write",
										"on": {
											"$slot": "entry"
										}
									}
								]
							},
							"onClick": {
								"$call": "content.unpublish",
								"input": {
									"collection": {
										"$slot": "entry.collection"
									},
									"id": {
										"$slot": "entry.id"
									}
								},
								"then": [
									"reload:page"
								],
								"notice": "The post is offline."
							}
						}
					}
				]
			}
		]
