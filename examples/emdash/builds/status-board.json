	"code": {
		"language": "javascript",
		"source": "// A button per status with how many posts have it, and the posts with the\n// chosen status, each with the declared action that moves it to the other.\nfunction draw(posts, state) {\n\tconst all = Array.isArray(posts) ? posts : [];\n\tconst status = state && state.status === 'published' ? 'published' : 'draft';\n\tconst count = (s) => all.filter((post) => post.status === s).length;\n\tconst tab = (id, label, s) => ({\n\t\ttype: 'button',\n\t\tprops: { id, label: `${label} (${count(s)})`, style: s === status ? 'primary' : 'secondary', onClick: { $event: 'show', payload: { status: s } } },\n\t});\n\tconst drafts = status === 'draft';\n\treturn {\n\t\ttype: 'stack',\n\t\tchildren: [\n\t\t\t{ type: 'context', props: { text: `Drafts: ${count('draft')} · Published: ${count('published')}` } },\n\t\t\t{ type: 'actions', children: [tab('drafts', 'Drafts', 'draft'), tab('published', 'Published', 'published')] },\n\t\t\t{\n\t\t\t\ttype: 'table',\n\t\t\t\tprops: {\n\t\t\t\t\trows: all.filter((post) => post.status === status),\n\t\t\t\t\tcolumns: [\n\t\t\t\t\t\t{ key: 'title', label: 'Title', primary: true },\n\t\t\t\t\t\t{ key: 'updatedAt', label: 'Last updated', format: 'relative_time' },\n\t\t\t\t\t],\n\t\t\t\t\tactions: [drafts ? { id: 'publish', label: 'Publish', style: 'primary', onClick: { $use: 'publish' } } : { id: 'unpublish', label: 'Unpublish', onClick: { $use: 'unpublish' } }],\n\t\t\t\t\tempty: drafts ? 'No drafts' : 'Nothing published',\n\t\t\t\t},\n\t\t\t},\n\t\t],\n\t};\n}\n\n// Showing drafts or published posts.\nfunction show(state, event, payload) {\n\treturn event === 'show' ? { status: payload && payload.status === 'published' ? 'published' : 'draft' } : state;\n}\n",
		"functions": [
			"draw",
			"show"
		]
	},
