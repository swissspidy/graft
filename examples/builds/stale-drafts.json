		"hash": "sha256:d8b175a5187c29e53e231197e32aa74e34711ee0a397df32fec0a55f27b15ba0"
	},
	"mount": {
		"slot": "dashboard.widget",
		"title": "Stale drafts"
	},
	"data": {
		"drafts": {
			"call": "posts.list",
			"input": {
				"status": [
					"draft"
				],
				"per_page": 10,
				"orderby": "modified",
				"order": "asc"
			}
		}
	},
	"tree": {
		"type": "table",
		"props": {
			"rows": {
				"$data": "drafts.items"
			},
			"fields": [
				{
					"id": "title",
					"label": "Title",
					"primary": true
				},
				{
					"id": "author.name",
					"label": "Author",
					"type": "user"
				},
				{
					"id": "age",
					"label": "Days since update",
					"type": "integer",
					"value": {
						"$daysSince": {
							"$field": "modified"
						}
					},
					"tone": {
						"$if": [
							{
								"$gte": [
									{
										"$daysSince": {
											"$field": "modified"
										}
									},
									30
								]
							},
							"error",
							{
								"$if": [
									{
										"$gte": [
											{
												"$daysSince": {
													"$field": "modified"
												}
											},
											7
										]
									},
									"warning",
									"success"
								]
							}
						]
					}
				}
			],
			"empty": "No drafts"
		}
	},
	"checks": [
		{
			"criterion": "drafts-only",
			"fixtures": {
				"users": [
					{
						"as": "e",
						"role": "editor"
					}
				],
				"posts": [
					{
						"title": "Draft A",
						"status": "draft"
					},
					{
						"title": "Pending B",
						"status": "pending"
					},
					{
						"title": "Post C",
						"status": "publish"
					}
				]
			},
			"view_as": "e",
			"expect": [
				{
					"rows": [
						"Draft A"
					]
				},
				{
					"columns": [
						"Title",
						"Author",
						"Days since update"
					]
				}
			]
		},
