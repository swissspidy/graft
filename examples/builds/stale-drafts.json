{
	"graft": 1,
	"spec": {
		"id": "stale-drafts",
		"hash": "sha256:41bfa1153acecd449d4ce7224006ba440bf93bf14b183c0d5cccaa2695442019"
	},
	"surface": {
		"host": "wordpress",
