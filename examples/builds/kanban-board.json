		"components": [
			{
				"id": "root",
				"component": "Board",
				"items": {
					"path": "/posts/items"
				},
				"columnBy": "status",
				"columns": [
					{
						"id": "draft",
						"title": "Draft",
						"empty": "No drafts."
					},
					{
						"id": "pending",
						"title": "Pending review",
						"empty": "Nothing is waiting for review."
					},
					{
						"id": "publish",
						"title": "Published",
						"empty": "Nothing published yet."
					}
				],
				"fields": [
					{
						"id": "title",
						"label": "Title",
						"type": "string",
						"primary": true
					},
					{
						"id": "author/name",
						"label": "Author",
						"type": "user"
					},
					{
						"id": "updated",
						"label": "Updated",
						"type": "string",
						"value": {
							"call": "if",
							"args": {
								"condition": {
									"call": "lessThan",
									"args": {
										"a": {
											"call": "daysSince",
											"args": {
												"value": {
													"path": "modified"
												}
											}
										},
										"b": 1
									}
								},
								"then": "today",
								"else": {
									"call": "if",
									"args": {
										"condition": {
											"call": "equals",
											"args": {
												"a": {
													"call": "daysSince",
													"args": {
														"value": {
															"path": "modified"
														}
													}
												},
												"b": 1
											}
										},
										"then": "1 day ago",
										"else": {
											"call": "formatString",
											"args": {
												"value": "${daysSince(value: ${modified})} days ago"
											}
										}
									}
								}
							}
						}
					}
				],
				"moves": [
					{
						"id": "to-pending",
						"label": "Pending review →",
						"from": "draft",
						"to": "pending",
						"variant": "primary",
						"visible": {
							"call": "can",
							"args": {
								"scope": "posts.review:write"
							}
						},
						"action": {
							"event": {
								"name": "send-for-review",
								"context": {
									"id": {
										"path": "id"
									}
								}
							}
						}
					},
					{
						"id": "to-draft",
						"label": "← Draft",
						"from": "pending",
						"to": "draft",
						"visible": {
							"call": "can",
							"args": {
								"scope": "posts.review:write"
							}
						},
						"action": {
							"event": {
								"name": "back-to-draft",
								"context": {
									"id": {
										"path": "id"
									}
								}
							}
						}
					},
					{
						"id": "publish",
						"label": "Published →",
						"from": "pending",
						"to": "publish",
						"variant": "primary",
						"visible": {
							"call": "can",
							"args": {
								"scope": "posts.status:write"
							}
						},
						"action": {
							"event": {
								"name": "publish",
								"context": {
									"id": {
										"path": "id"
									}
								}
							}
						}
					},
					{
						"id": "unpublish",
						"label": "← Pending review",
						"from": "publish",
						"to": "pending",
						"visible": {
							"call": "can",
							"args": {
								"scope": "posts.status:write"
							}
						},
						"action": {
							"event": {
								"name": "unpublish",
								"context": {
									"id": {
										"path": "id"
									}
								}
							}
						}
					}
				]
			}
		]
	},
	"events": {
		"send-for-review": {
			"call": "posts.update_review_status",
			"input": {
				"id": {
					"$context": "id"
				},
				"status": "pending"
			},
			"then": [
				"refresh:posts"
			],
			"notice": "Sent for review."
		},
		"back-to-draft": {
			"call": "posts.update_review_status",
			"input": {
				"id": {
					"$context": "id"
				},
				"status": "draft"
			},
			"then": [
				"refresh:posts"
			],
			"notice": "Moved back to draft."
		},
		"publish": {
			"call": "posts.update_status",
			"input": {
				"id": {
					"$context": "id"
				},
				"status": "publish"
			},
			"then": [
				"refresh:posts"
