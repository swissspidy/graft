	"code": {
		"language": "javascript",
		"source": "// The buttons (one per author, with how many posts each has waiting)\n// and the pending posts of the chosen author, or everyone's.\nfunction draw(posts, state) {\n\tconst all = Array.isArray(posts) ? posts : [];\n\tconst chosen = state && state.author;\n\tconst authors = [];\n\tfor (const post of all) {\n\t\tconst found = authors.find((a) => a.name === post.author.name);\n\t\tif (found) {\n\t\t\tfound.count += 1;\n\t\t} else {\n\t\t\tauthors.push({ name: post.author.name, count: 1 });\n\t\t}\n\t}\n\tauthors.sort((a, b) => a.name.localeCompare(b.name));\n\tconst slug = (text) => text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');\n\tconst button = (id, label, author) => ({\n\t\ttype: 'button',\n\t\tprops: {\n\t\t\tid,\n\t\t\tlabel,\n\t\t\tvariant: (chosen || null) === author ? 'primary' : 'secondary',\n\t\t\tonClick: { $event: 'choose', payload: { author } },\n\t\t},\n\t});\n\treturn {\n\t\ttype: 'stack',\n\t\tprops: { gap: 3 },\n\t\tchildren: [\n\t\t\t{\n\t\t\t\ttype: 'stack',\n\t\t\t\tprops: { direction: 'row', gap: 2 },\n\t\t\t\tchildren: [button('everyone', `Everyone (${all.length})`, null)].concat(\n\t\t\t\t\tauthors.map((a) => button(`author-${slug(a.name)}`, `${a.name} (${a.count})`, a.name)),\n\t\t\t\t),\n\t\t\t},\n\t\t\t{\n\t\t\t\ttype: 'table',\n\t\t\t\tprops: {\n\t\t\t\t\trows: all.filter((post) => !chosen || post.author.name === chosen),\n\t\t\t\t\tfields: [\n\t\t\t\t\t\t{ id: 'title', label: 'Title', primary: true },\n\t\t\t\t\t\t{ id: 'author.name', label: 'Author' },\n\t\t\t\t\t],\n\t\t\t\t\t// The widget's declared \"approve\" action, on each row.\n\t\t\t\t\tactions: [{ id: 'approve', label: 'Approve', primary: true, onClick: { $use: 'approve' } }],\n\t\t\t\t\tempty: 'Nothing is waiting',\n\t\t\t\t},\n\t\t\t},\n\t\t],\n\t};\n}\n\n// Choosing an author, or everyone.\nfunction choose(state, event, payload) {\n\treturn event === 'choose' ? { author: payload && payload.author ? payload.author : null } : state;\n}\n",
		"functions": [
			"draw",
			"choose"
		]
	},
