	"code": {
		"language": "javascript",
		"source": "// What is wrong with a headline, as a list of problems.\nfunction headlineProblems(title) {\n\tconst problems = [];\n\tconst text = String(title).trim();\n\tif (text.length > 70) {\n\t\tproblems.push('Too long');\n\t}\n\tconst letters = text.replace(/[^A-Za-zÀ-ɏ]/g, '');\n\tif (letters.length >= 4 && letters === letters.toUpperCase()) {\n\t\tproblems.push('All caps');\n\t}\n\tif (text.split(/\\s+/).filter(Boolean).length < 3) {\n\t\tproblems.push('Too short');\n\t}\n\treturn problems;\n}\n\n// The verdict to show: the problems, or that it looks good.\nfunction headlineVerdict(title) {\n\tconst problems = headlineProblems(title);\n\treturn problems.length === 0 ? 'Looks good' : problems.join(', ');\n}\n",
		"functions": [
			"headlineVerdict"
		]
	},
