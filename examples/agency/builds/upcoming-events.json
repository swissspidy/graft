				"posts": [
					{
						"title": "Open rehearsal",
						"type": "event",
						"status": "publish",
						"meta": {
							"event_date": "2026-10-12"
						}
					},
					{
						"title": "Jazz night",
						"type": "event",
						"status": "publish",
						"meta": {
							"event_date": "2026-11-20",
							"venue": "Main hall"
						}
					}
				]
			},
			"view_as": "e",
			"expect": [
				{
					"cell": {
						"row": {
							"title": "Open rehearsal"
						},
						"column": "Venue",
