					},
					{
						"title": "Season announcement",
						"status": "publish"
					},
					{
						"title": "About us",
						"type": "page",
						"status": "publish"
					}
				]
			},
			"view_as": "e",
			"expect": [
				{
					"rows": [
						"Poetry slam",
						"Jazz night",
						"Date to be announced"
					]
				}
			]
		},
		{
			"criterion": "details",
			"fixtures": {
				"users": [
					{
						"as": "e",
						"role": "editor"
					}
				],
				"posts": [
					{
						"title": "Jazz night",
						"type": "event",
						"status": "publish",
						"meta": {
							"event_date": "2026-11-20",
							"venue": "Main hall",
							"capacity": 240
