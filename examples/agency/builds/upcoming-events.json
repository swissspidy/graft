{
	"graft": 1,
	"spec": {
		"id": "upcoming-events",
		"hash": "sha256:c8323508e979adb469d1ce701c1204c55995305f6222118f2cbacd7fe9375135"
	},
	"surface": {
		"host": "wordpress",
		"hostVersion": "7.1.2",
		"hash": "sha256:05a8b3caa16f7a75fea1d891bcd0acf7519150b14ee305e56faa120a61f1ae2b"
	},
	"mount": {
		"slot": "dashboard.widget",
		"title": "Upcoming events"
	},
	"data": {
		"events": {
			"call": "posts.list",
			"input": {
				"post_type": "event",
				"status": [
					"publish",
					"future"
				],
				"per_page": 20,
				"orderby": "meta.event_date",
				"order": "asc"
			}
		}
	},
	"tree": {
		"type": "table",
		"props": {
			"rows": {
				"$data": "events.items"
			},
			"fields": [
				{
					"id": "title",
					"label": "Event",
					"primary": true
				},
				{
					"id": "meta.event_date",
					"label": "Date",
					"type": "date"
				},
				{
					"id": "meta.venue",
					"label": "Venue",
					"value": {
						"$if": [
							{
								"$eq": [
									{
										"$field": "meta.venue"
									},
									null
								]
							},
							"Venue missing",
							{
								"$field": "meta.venue"
							}
						]
					},
					"tone": {
						"$if": [
							{
								"$eq": [
									{
										"$field": "meta.venue"
									},
									null
								]
							},
							"error",
							null
						]
					}
				},
				{
					"id": "meta.capacity",
					"label": "Seats",
					"type": "integer"
				}
			],
			"actions": [
				{
					"id": "sold-out",
					"label": "Mark sold out",
					"visible": {
						"$and": [
							{
								"$can": "posts.meta:write",
								"on": {
									"$field": "id"
								}
							},
							{
								"$not": {
									"$eq": [
										{
											"$field": "meta.sold_out"
										},
										true
									]
								}
							}
						]
					},
					"onClick": {
						"$call": "posts.update_meta",
						"input": {
							"id": {
								"$field": "id"
							},
							"meta": {
								"sold_out": true
							}
						},
						"then": [
							"refresh:events"
						],
						"notice": "Marked sold out."
					}
				}
			],
			"empty": "No upcoming events"
		}
	},
	"checks": [
		{
			"criterion": "events-soonest-first",
			"fixtures": {
				"users": [
					{
						"as": "e",
						"role": "editor"
					}
				],
				"posts": [
					{
						"title": "Date to be announced",
