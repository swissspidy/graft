{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graft.dev/schemas/build/1.json",
  "title": "Graft build",
  "description": "A disposable build of one spec version against one surface: its UI (an A2UI surface with its event bindings), its data sources, frozen checks, computed refs and provenance. A pure function of (spec hash, surface hash, compiler version).",
  "type": "object",
  "required": ["graft", "spec", "surface", "mount", "ui", "events", "data", "checks", "refs", "provenance"],
  "additionalProperties": false,
  "properties": {
    "graft": { "const": 1 },
    "spec": {
      "type": "object",
      "required": ["id", "hash"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "hash": { "type": "string" }
      }
    },
    "surface": {
      "type": "object",
      "required": ["host", "hash"],
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string" },
        "hostVersion": { "type": "string" },
        "hash": { "type": "string" }
      }
    },
    "mount": {
      "type": "object",
      "required": ["slot"],
      "properties": { "slot": { "type": "string" } }
    },
    "ui": {
      "description": "The UI: the protocol and catalog it draws from, and the format's own content (A2UI: components, initial and computed data model values). A registered UI format validates the rest.",
      "type": "object",
      "required": ["protocol", "catalogId"],
      "properties": {
        "protocol": { "type": "string" },
        "catalogId": { "type": "string" }
      }
    },
    "events": {
      "description": "What each action event of the UI does: a capability call. {\"$context\": \"<key>\"} in the input stands for a value of the event's context.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["call"],
        "additionalProperties": false,
        "properties": {
          "call": { "type": "string" },
          "input": true,
          "then": { "type": "array", "items": { "type": "string" } },
          "notice": { "type": "string" }
        }
      }
    },
    "data": {
      "description": "Named data sources, each a capability call with fixed or bound input.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["call"],
        "additionalProperties": false,
        "properties": {
          "call": { "type": "string" },
          "input": { "$ref": "#/$defs/value" }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "refs": {
      "description": "Every surface symbol the build uses. Computed from the UI, data and checks, never trusted from the model.",
      "type": "object",
      "required": ["slot", "capabilities", "scopes", "catalog"],
      "additionalProperties": false,
      "properties": {
        "slot": { "type": "string" },
        "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "scopes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "catalog": {
          "type": "object",
          "description": "Component type to the properties the UI uses, in its catalog.",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["compiler"],
      "additionalProperties": true,
      "properties": {
        "compiler": { "type": "string" },
        "model": { "type": "string" },
        "promptHash": { "type": "string" },
        "strategy": { "enum": ["handwritten", "compiled", "migrated", "reanchored", "regenerated"] },
        "replaces": { "description": "Hash of the build this one replaced.", "type": "string" }
      }
    }
  },
  "$defs": {
    "value": {
      "description": "A data source input: a literal, or one of the expression forms. No JavaScript, PHP or HTML strings.",
      "anyOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/value" } },
        { "$ref": "#/$defs/dataRef" },
        { "$ref": "#/$defs/slotRef" },
        { "$ref": "#/$defs/can" },
        { "$ref": "#/$defs/eq" },
        { "$ref": "#/$defs/and" },
        { "$ref": "#/$defs/or" },
        { "$ref": "#/$defs/not" },
        { "$ref": "#/$defs/compare" },
        { "$ref": "#/$defs/if" },
        { "$ref": "#/$defs/daysSince" },
        {
          "description": "A plain object. Keys starting with $ are reserved for expressions.",
          "type": "object",
          "propertyNames": { "pattern": "^[^$]" },
          "additionalProperties": { "$ref": "#/$defs/value" }
        }
      ]
    },
    "dataRef": {
      "type": "object",
      "required": ["$data"],
      "additionalProperties": false,
      "properties": { "$data": { "description": "Path into a named data source, e.g. queue.items.", "type": "string" } }
    },
    "slotRef": {
      "type": "object",
      "required": ["$slot"],
      "additionalProperties": false,
      "properties": { "$slot": { "description": "Prop provided by the slot, e.g. post.id.", "type": "string" } }
    },
    "can": {
      "type": "object",
      "required": ["$can"],
      "additionalProperties": false,
      "properties": {
        "$can": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*:(read|write)$" },
        "on": { "$ref": "#/$defs/value" }
      }
    },
    "eq": {
      "description": "True when both values are equal (strict, JSON equality).",
      "type": "object",
      "required": ["$eq"],
      "additionalProperties": false,
      "properties": { "$eq": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/value" } } }
    },
    "and": {
      "type": "object",
      "required": ["$and"],
      "additionalProperties": false,
      "properties": { "$and": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/value" } } }
    },
    "or": {
      "type": "object",
      "required": ["$or"],
      "additionalProperties": false,
      "properties": { "$or": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/value" } } }
    },
    "not": {
      "type": "object",
      "required": ["$not"],
      "additionalProperties": false,
      "properties": { "$not": { "$ref": "#/$defs/value" } }
    },
    "compare": {
      "description": "Compares two numbers (or two strings): {\"$gt\": [a, b]}, and likewise $gte, $lt, $lte.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "$gt": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/value" } },
        "$gte": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/value" } },
        "$lt": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/value" } },
        "$lte": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/value" } }
      }
    },
    "if": {
      "description": "A choice: {\"$if\": [condition, then, else]}.",
      "type": "object",
      "required": ["$if"],
      "additionalProperties": false,
      "properties": { "$if": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/value" } } }
    },
    "daysSince": {
      "description": "Whole days from a date (ISO 8601) to now: {\"$daysSince\": date}. Null when it is not a date.",
      "type": "object",
      "required": ["$daysSince"],
      "additionalProperties": false,
      "properties": { "$daysSince": { "$ref": "#/$defs/value" } }
    },
    "check": {
      "type": "object",
      "required": ["criterion", "expect"],
      "additionalProperties": false,
      "properties": {
        "criterion": { "description": "Acceptance criterion id this check proves.", "type": "string" },
        "fixtures": {
          "description": "Synthetic fixtures seeded in the sandbox. Shape is adapter-defined.",
          "type": "object"
        },
        "clock": {
          "description": "When the check looks, relative to when its fixtures were seeded: {\"advanceDays\": 10} views the build ten days later.",
          "type": "object",
          "required": ["advanceDays"],
          "additionalProperties": false,
          "properties": { "advanceDays": { "type": "number", "minimum": 0, "maximum": 3650 } }
        },
        "view_as": { "type": "string" },
        "steps": {
          "description": "Actions performed before the expectations are evaluated.",
          "type": "array",
          "items": {
            "oneOf": [
              {
                "description": "Use an action: a button, a row action.",
                "type": "object",
                "required": ["action"],
                "additionalProperties": false,
                "properties": {
                  "action": { "type": "string" },
                  "row": { "type": "object" }
                }
              },
              {
                "description": "Type a value into an input field (a checkbox takes true or false).",
                "type": "object",
                "required": ["fill", "value"],
                "additionalProperties": false,
                "properties": {
                  "fill": { "type": "string" },
                  "value": { "type": ["string", "boolean"] },
                  "row": { "type": "object" }
                }
              }
            ]
          }
        },
        "expect": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "object", "minProperties": 1 }
        }
      }
    }
  }
}
